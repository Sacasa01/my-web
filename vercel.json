{
  "framework": "angular",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/portfolio/browser",
  "routes": [
    {
      "src": "/videos/(.*)",
      "dest": "/videos/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
