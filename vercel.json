{
  "framework": "angular",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/my-web/browser",
  "env": {
    "GEMINI_API_KEY": "@gemini-api-key"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/videos/(.*)",
      "dest": "/videos/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
